---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site, localize, siteUrl, type Locale } from "../config";
import { t } from "../i18n";
import { absoluteUrl } from "../lib/paths";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  alternatePath: string;
  ogType?: "website" | "article";
  image?: string;
  noindex?: boolean;
  publishedTime?: Date;
  tags?: string[];
}

const {
  locale,
  title,
  description,
  path,
  alternatePath,
  ogType = "website",
  image = "/og.png",
  noindex = false,
  publishedTime,
  tags = [],
} = Astro.props;

const base = siteUrl();
const canonical = absoluteUrl(base, path);
const alternateEs = locale === "es" ? canonical : absoluteUrl(base, alternatePath);
const alternateEn = locale === "en" ? canonical : absoluteUrl(base, alternatePath);
const ogImage = absoluteUrl(base, image);
const jsonLd =
  ogType === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        datePublished: publishedTime?.toISOString(),
        image: ogImage,
        inLanguage: locale,
        author: {
          "@type": "Person",
          name: site.author.name,
          url: site.author.url,
        },
        publisher: {
          "@type": "Person",
          name: site.author.name,
          url: site.author.url,
        },
        keywords: tags.join(", "),
        mainEntityOfPage: canonical,
      }
    : {
        "@context": "https://schema.org",
        "@type": "Blog",
        name: site.name,
        url: base,
        description: localize(site.description, locale),
        inLanguage: locale,
        author: {
          "@type": "Person",
          name: site.author.name,
          url: site.author.url,
          sameAs: site.socials.map((item) => item.url),
        },
      };
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#12110e" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={site.defaultLocale === "en" ? alternateEn : alternateEs} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={`${base}/rss.xml`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "es" ? "en_US" : "es_ES"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={site.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("blog-sencillo-theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true"></div>
    <a class="skip" href="#contenido">{t(locale, "skip")}</a>
    <div class="page">
      <Header locale={locale} />
      <slot />
      <Footer locale={locale} />
    </div>
    <script>
      const root = document.documentElement;
      const button = document.querySelector("[data-theme-toggle]");

      function currentTheme() {
        return root.dataset.theme === "light" ? "light" : "dark";
      }

      function apply(theme: string) {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        try {
          localStorage.setItem("blog-sencillo-theme", theme);
        } catch {
          /* ignore */
        }
        if (button instanceof HTMLButtonElement) {
          const next = theme === "dark" ? "light" : "dark";
          button.setAttribute("aria-label", next === "light" ? button.dataset.labelLight || "" : button.dataset.labelDark || "");
          button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
        }
      }

      if (button instanceof HTMLButtonElement) {
        apply(currentTheme());
        button.addEventListener("click", () => {
          apply(currentTheme() === "dark" ? "light" : "dark");
        });
      }
    </script>
  </body>
</html>
