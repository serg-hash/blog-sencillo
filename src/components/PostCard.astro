---
import type { Locale } from "../config";
import { t } from "../i18n";
import { formatDate, slugifyTag } from "../lib/format";
import { postPath, tagPath } from "../lib/paths";
import { readingMinutes } from "../lib/reading-time";
import type { Post } from "../lib/posts";

interface Props {
  locale: Locale;
  post: Post;
  featured?: boolean;
}

const { locale, post, featured = false } = Astro.props;
const href = postPath(locale, post.id);
const minutes = readingMinutes(post.body);
---

<article class:list={["card", { featured }]}>
  {
    post.data.cover && (
      <a class="card-cover" href={href} tabindex="-1" aria-hidden="true">
        <img src={post.data.cover} alt="" width="720" height="405" loading={featured ? "eager" : "lazy"} />
      </a>
    )
  }
  <div class="card-body">
    <div class="meta">
      {post.data.draft && <span class="badge">{t(locale, "draft")}</span>}
      {featured && <span class="badge">{t(locale, "featured")}</span>}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
      <span>{minutes} {t(locale, "readingTime")}</span>
    </div>
    <h2 class="card-title">
      <a href={href}>{post.data.title}</a>
    </h2>
    <p class="card-desc">{post.data.description}</p>
    {
      post.data.tags.length > 0 && (
        <p class="tags">
          {post.data.tags.map((tag) => (
            <a class="tag" href={tagPath(locale, slugifyTag(tag))}>
              {tag}
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>
